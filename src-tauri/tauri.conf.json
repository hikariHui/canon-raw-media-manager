{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "canon-raw-media-manager",
  "version": "2.4.0",
  "identifier": "com.hikarihui.canon-raw-media-manager",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Canon 媒体管理器",
        "width": 1920,
        "height": 1080
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/ffmpeg", "binaries/ffprobe"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhEMDlDNjk4MzIwMDg5NwpSV1NYQ0NDRGFaelFDTGpaaDI1RzBTL3lUL21md2hsRWtWN05PYWpRTWZjZmRET2VHTFBSZ1hDZwo=",
      "endpoints": [
        "https://github.com/hikariHui/canon-raw-media-manager/releases/latest/download/latest.json"
      ]
    }
  }
}
